@using e_sportsMVC.Models

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div>
    <table class="table">
        <tbody>
            @if (DataBaseModel.ChampionShips != null && DataBaseModel.ChampionShips.Any())
            {
                @foreach (ChampionShipModel championship in DataBaseModel.ChampionShips)
                {
                    <tr>                       
                        <td style="width: 50px;">
                            <form asp-action="DeleteChampionShip" method="post" onsubmit="return confirm('Eliminar?');">
                                <input type="hidden" name="id" value="@championship.ID" />
                            </form>
                        </td>                     
                       
                    </tr>
                }
            }
        </tbody>
    </table>
</div>