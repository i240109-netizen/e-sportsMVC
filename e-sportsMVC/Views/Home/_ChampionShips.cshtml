@model e_sportsMVC.Models.ChampionShipModel

<form asp-controller="Home" asp-action="CreateChampionShip" method="post">
    <div>
        <h3>Create ChampionShip</h3>
        <label asp-for="ID">ID</label>
        <input asp-for="ID" name="ID" />
        <span asp-validation-for="ID" class="text-danger"></span>

        <label asp-for="Name">Name</label>
        <input asp-for="Name" name="Name" />
        <span asp-validation-for="Name" class="text-danger">
        </span>

        <label asp-for="Year">Year</label>
        <input asp-for="Year" name="Year" />
        <span asp-validation-for="Year" class="text-danger"> </span>

        <button type="submit" class="btn btn-success">Create</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}