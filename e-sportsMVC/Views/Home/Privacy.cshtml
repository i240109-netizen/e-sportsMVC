@{
    ViewData["Title"] = "Export/Import";
}
<h1>@ViewData["Title"]</h1>

<p>Exportar e Importar XML e JSON</p>


<div id="exportDiv" class="div">
    <h2>Export</h2>
    <p>Escolhe o formato para exportar:</p>
    <button class="btn btn-primary btn-group">Export as XML</button>
    <button class="btn btn-primary btn-group">Export as Json</button>
</div>

<div id="importDiv" class="div">
    <h2>Import</h2>
    <p>Escolhe o formato para importar:</p>
    <button class="btn btn-danger btn-group">Import as XML</button>
    <button class="btn btn-danger btn-group">Import as Json</button>
</div>