@model IEnumerable<e_sportsMVC.Models.MatchModel>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Tourmnet</th>
                <th>Date</th>
                <th>Team A</th>
                <th>Team B</th>
                <th>Result A</th>
                <th>Result B</th>
                <th>State</th>
                <td style="width: 50px;"><button>Delete</button></td>
                <td style="width: 30px;"><button>Edit</button></td>
            </tr>
        </thead>
        <tbody id="players">
            @if(Model != null && Model.Any())
            {
                @foreach (MatchModel match in Model)
                {
                    <tr>
                        <td>@match.ID</td>
                        <td>@match.TournamentID</td>
                        <td>@match.Date</td>
                        <td>@match.TeamAID</td>
                        <td>@match.TeamBID</td>
                        <td>@match.ResultA</td>
                        <td>@match.ResultB</td>
                        <td>@match.State</td>
                        <td style="width: 50px;"><button>Delete</button></td>
                        <td style="width: 30px;"><button>Edit</button></td>
                    </tr>
                }
            })

        </tbody>
    </table>
</div>