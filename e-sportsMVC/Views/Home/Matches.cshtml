@model IEnumerable<e_sportsMVC.Models.MatchModel>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tourment</th>
                <th>Date</th>
                <th>Team A</th>
                <th>Team B</th>
                <th>Result A</th>
                <th>Result B</th>
                <th>State</th>
                <th>Actions</th> <!-- Apenas cabeçalho limpo -->
            </tr>
        </thead>
        <tbody id="players">
            @if (Model != null && Model.Any())
            {
                @foreach (var match in Model)
                {
                    <tr>
                        <td>@match.ID</td>
                        <td>@match.TournamentID</td>
                        <td>@match.Date</td>
                        <td>@match.TeamAID</td>
                        <td>@match.TeamBID</td>
                        <td>@match.ResultA</td>
                        <td>@match.ResultB</td>
                        <td>
                            @* Se for apenas para mostrar/selecionar visualmente *@
                            <select asp-for="@match.State" asp-items="Html.GetEnumSelectList<e_sportsMVC.Models.MatchModel.enumState>()" class="form-control">
                                <option value="">-- Seleciona o Estado --</option>
                            </select>
                        </td>
                        <td style="width: 50px;"><button class="btn btn-danger btn-sm">Delete</button></td>
                        <td style="width: 30px;"><button class="btn btn-primary btn-sm">Edit</button></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center">Não existem partidas registadas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <h3>Create Match</h3>
    <input>Tournament</input>
    <input>Date</input>
    <input>Name</input>
    <input>Team A</input>
    <input>Team B</input>
    <input>ResultA</input>
    <input>ResultB</input>
    <button>Create</button>
</div>