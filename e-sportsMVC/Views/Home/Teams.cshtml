@model IEnumerable<e_sportsMVC.Models.TeamModel>

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Captain</th>
                <th>Name</th>
                <th>Country</th>
                <th style="width: 30px;">Players</th>
                <td style="width: 50px;"><button onclick="">Delete</button></td>
                <td style="width: 30px;"><button>Edit</button></td>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (TeamModel team in Model)
                {
                    <tr>
                        <td>@team.ID</td>
                        <td>@team.CaptainId</td>
                        <td>@team.Name</td>
                        <td>@team.Country</td>
                        <td>
                            <details>
                                <summary>Players(@team.Players.Count())</summary>
                                <ul>
                                    @foreach (PlayerModel player in team.Players)
                                    {
                                        <li>@player.NickName</li>
                                    }
                                </ul>
                            </details>
                        </td>
                        <td style="width: 50px;"><button class="btn btn-danger btn-sm">Delete</button></td>
                        <td style="width: 30px;"><button class="btn btn-primary btn-sm">Edit</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Teams" model="new e_sportsMVC.Models.TeamModel()"></partial>