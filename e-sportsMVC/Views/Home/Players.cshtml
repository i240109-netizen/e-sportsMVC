@model IEnumerable<e_sportsMVC.Models.PlayerModel>

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    var ChampionShips = Model;
}

<div>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Team</th>
                <th>Name</th>
                <th>Nickname</th>
                <th>Age</th>
                <th>Points</th>
                <th style="width: 50px;">Delete</th>
                <th style="width: 30px;">Edit</th>
            </tr>
        </thead>
        <tbody>
           @if (Model != null && Model.Any())
            {
                @foreach (PlayerModel player in Model)
                {
                    <tr>
                        <td>@player.ID</td>
                        <td>@player.TeamID</td>
                        <td>@player.Name</td>
                        <td>@player.NickName</td>
                        <td>@player.Age</td>
                        <td>
                            <details>
                                <summary>Points(@player.Points.Count())</summary>
                                <ul>
                                    @foreach (int points in player.Points)
                                    {
                                        <li>@points Points</li>    
                                    }
                                </ul>
                            </details>
                        </td>
                        <td style="width: 50px;"><button class="btn btn-danger btn-sm">Delete</button></td>
                        <td style="width: 30px;"><button class="btn btn-primary btn-sm">Edit</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    
</div>

<div>
    <h3>Create Player</h3>
    <input>ID</input>
    <input>Team</input>
    <input>Name</input>
    <input>NickName</input>
    <input type="number">Age</input>
    <button>Create</button>
</div>