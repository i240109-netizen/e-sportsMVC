@model IEnumerable<e_sportsMVC.Models.ChampionShipModel>

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Year</th>
                <th style="width: 30px;">Tourments</th>
                <th style="width: 50px;">Delete</th>
                <th style="width: 30px;">Edit</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (ChampionShipModel championship in Model)
                {
                    <tr>
                        <td>@championship.ID</td>
                        <td>@championship.Name</td>
                        <td>@championship.Year</td>
                        <td>
                            <details>
                                <summary>Tournaments(@championship.Tournaments.Count())</summary>
                                <ul>
                                    @foreach (TournamentModel tournament in championship.Tournaments)
                                    {
                                        <li>@tournament.Name</li>
                                    }
                                </ul>
                            </details>
                        </td>
                        <td style="width: 50px;"><button class="btn btn-danger btn-sm">Delete</button></td>
                        <td style="width: 30px;"><button class="btn btn-primary btn-sm">Edit</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<form asp-controleer="ChampionShipModel" asp-action="Create" method="post">
<div>
    <h3>Create ChampionShip</h3>
    <input id="ID">ID</input>
    <input id="Name">Name</input>
    <input id="Year">Year</input>
    <button type="submit">Create</button>
</div>
</form>