@model IEnumerable<e_sportsMVC.Models.TournamentModel>

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div>
    <form asp-action="SelectChampionShip" method="post">
        <div class="form-group">
            <label for="championShipSelect">Campeonato</label>
            <select id="championShipSelect" name="selectedChampionShipId" class="form-select">
                <option value="">-- Selecione um campeonato --</option>
                @foreach (var item in DataBaseModel.ChampionShips)
                {
                    <option value="@item.Name">@item.Name</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary mt-2">Confirmar</button>
    </form>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>ChampionShip</th>
                <th>Name</th>
                <th>Game</th>
                <th>State</th>
                <th style="width: 30px;">Teams</th>
                <th style="width: 30px;">Matchs</th>
                <th style="width: 50px;">Delete</th>
                <th style="width: 30px;">Edit</th>
            </tr>
        </thead>
        <tbody>
            @if(@Model.Any() && @Model != null)
            {
                @foreach (TournamentModel tournament in Model)
                {
                    <tr>
                        <td>@tournament.ID</td>
                        <td>@tournament.ChampionShipId</td>
                        <td>@tournament.Name</td>
                        <td>@tournament.Game</td>
                        <td>@tournament.State</td>
                        <td>
                            <details>
                                <summary>Teams (@tournament.Teams.Count())</summary>
                                <ul>
                                    @foreach (TeamModel team in tournament.Teams)
                                    {
                                        <li>@team.Name</li>
                                    }
                                </ul>
                            </details>
                        </td>
                        <td>
                            <details>
                                <summary>Matches (@tournament.Matches.Count())</summary>
                                <ul>
                                    @foreach (MatchModel match in tournament.Matches)
                                    {
                                        <li>@match.ID @match.State</li>
                                    }
                                </ul>
                            </details>
                        </td>
                        <td style="width: 50px;"><button class="btn btn-danger btn-sm">Delete</button></td>
                        <td style="width: 30px;"><button class="btn btn-primary btn-sm">Edit</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


<partial name="_Tournaments" model="new e_sportsMVC.Models.TournamentModel()"></partial>